# Open SIP Phone — development SIP accounts
# EN: copy this file to `.env.local` (git-ignored) and fill in real credentials.
# PT: copie este arquivo para `.env.local` (ignorado pelo Git) e preencha as credenciais reais.
#
# Up to 9 accounts are read: OPENSIP_ACCOUNT_<N>_*  (N = 1..9)
# An entry is seeded when USERNAME, PASSWORD and DOMAIN are all set.
#
# SERVER_URI is OPTIONAL. Leave it empty and Open SIP Phone discovers how to reach the
# domain by itself: it queries the SRV records (_sips._tcp, _sips._wss, _sip._tcp,
# _sip._ws, _sip._udp), falls back to the default port ladder, probes the candidates
# in order of preference (TLS, WSS, TCP, WS, UDP) and keeps the first that answers.
# Set it only to pin one specific path, e.g.:
#   tcp://pbx.example.com:5060
#   tls://pbx.example.com:5061
#   wss://pbx.example.com:8089/ws
# The legacy name OPENSIP_ACCOUNT_<N>_WS_SERVER is still accepted as an alias.

# --- Account 1 ---
OPENSIP_ACCOUNT_1_DISPLAY_NAME=Conta 1
OPENSIP_ACCOUNT_1_USERNAME=1001
OPENSIP_ACCOUNT_1_PASSWORD=
OPENSIP_ACCOUNT_1_DOMAIN=sip.example.com
OPENSIP_ACCOUNT_1_SERVER_URI=
OPENSIP_ACCOUNT_1_REGISTER_EXPIRES=600

# --- Account 2 ---
OPENSIP_ACCOUNT_2_DISPLAY_NAME=Conta 2
OPENSIP_ACCOUNT_2_USERNAME=1002
OPENSIP_ACCOUNT_2_PASSWORD=
OPENSIP_ACCOUNT_2_DOMAIN=sip.example.com
OPENSIP_ACCOUNT_2_SERVER_URI=
OPENSIP_ACCOUNT_2_REGISTER_EXPIRES=600

# --- Account 3 ---
OPENSIP_ACCOUNT_3_DISPLAY_NAME=Conta 3
OPENSIP_ACCOUNT_3_USERNAME=1003
OPENSIP_ACCOUNT_3_PASSWORD=
OPENSIP_ACCOUNT_3_DOMAIN=sip.example.com
OPENSIP_ACCOUNT_3_SERVER_URI=
OPENSIP_ACCOUNT_3_REGISTER_EXPIRES=600
